# Solana signer. Prefer a local ignored keypair path for production.
CREATOR_KEYPAIR_PATH=
# CREATOR_PRIVATE_KEY_BASE58=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
COMMITMENT=confirmed

# Your Pump.fun token mint.
PROJECT_TOKEN_MINT=

# Public UI labels only. Never put private keys in VITE_* values.
VITE_ENGINE_MODE=Prelaunch
VITE_ZEC3_CONTRACT_ADDRESS=

# Wrapped/tokenized ZEC on Solana. Default shown is the Zcash OmniBridge variant listed by tokens.solana.com.
ZEC_SOL_MINT=A7bdiYdS5GjqGFtxf17ppRHtDKPkkRqbKtR27dxvQXaS

# Allocation of newly claimed SOL creator fees, in basis points.
# Total must be <= 10000. Any remainder stays as SOL in treasury.
SOL_ZEC_BPS=3000
FLASH_LONG_BPS=3000
HOLDER_AIRDROP_BPS=3000

# Do not run if the newly claimed creator fees are below this many lamports.
MIN_CLAIMED_LAMPORTS=10000000

# Swap/trade controls.
JUPITER_SLIPPAGE_BPS=150
FLASH_LONG_LEVERAGE=1
FLASH_LONG_MAX_ORDER_USDC=250
FLASH_PERPS_ENABLED=false
FLASH_PERPS_MARKET=ZEC
FLASH_POOL=Crypto.1
FLASH_API_URL=https://flashapi.trade
FLASH_INPUT_TOKEN_SYMBOL=SOL
FLASH_SLIPPAGE_PERCENTAGE=0.8
# Optional exact trigger prices, not percentages.
FLASH_TAKE_PROFIT_PRICE=
FLASH_STOP_LOSS_PRICE=

# Runtime.
DRY_RUN=true
INTERVAL_MS=600000
LEDGER_PATH=./data/runs.jsonl

# Holder snapshot and airdrop dry-run.
BIRDEYE_API_KEY=
HOLDER_SNAPSHOT_PROVIDER=birdeye
HOLDER_SNAPSHOT_MIN_BALANCE=0
# Comma or space separated: treasury, team, LP, burn, and market-maker wallets.
HOLDER_EXCLUDED_WALLETS=
HOLDER_SNAPSHOT_PATH=./data/holders-snapshot.json
AIRDROP_DRY_RUN=true
AIRDROP_DRY_RUN_LAMPORTS=1000000000
AIRDROP_DRY_RUN_PATH=./data/airdrop-dry-run.json

# Generated by npm run dashboard:sync for the public dashboard.
PUBLIC_ENGINE_DATA_PATH=./public/runtime/engine.json
