# Solana signer. Prefer CREATOR_KEYPAIR_PATH for production.
CREATOR_KEYPAIR_PATH=./keys/creator.json
# CREATOR_PRIVATE_KEY_BASE58=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
COMMITMENT=confirmed

# Your Pump.fun token mint.
PROJECT_TOKEN_MINT=

# Wrapped/tokenized ZEC on Solana. Default shown is the Zcash OmniBridge variant listed by tokens.solana.com.
ZEC_SOL_MINT=A7bdiYdS5GjqGFtxf17ppRHtDKPkkRqbKtR27dxvQXaS

# Allocation of newly claimed SOL creator fees, in basis points.
# Total must be <= 10000. Any remainder stays as SOL in treasury.
SOL_ZEC_BPS=3000
JUPITER_LONG_BPS=3000
HOLDER_AIRDROP_BPS=3000

# Do not run if the newly claimed creator fees are below this many lamports.
MIN_CLAIMED_LAMPORTS=10000000

# Swap/trade controls.
JUPITER_SLIPPAGE_BPS=150
JUPITER_LONG_LEVERAGE=1
JUPITER_LONG_MAX_ORDER_USDC=250

# Runtime.
DRY_RUN=true
INTERVAL_MS=600000
LEDGER_PATH=./data/runs.jsonl
